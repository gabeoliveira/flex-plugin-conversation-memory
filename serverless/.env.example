# Twilio API Key/Secret pair used as Basic auth (apiKey:apiToken) against the
# Memora API. Use a standard API Key (SKxxxx) + its secret — NOT the account
# auth token. Create one at: Console → Account → API keys & tokens.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Memora store / service SID — this is the value used in the API path
# (/v1/Stores/{MEMORY_STORE_ID}/...). It looks like mem_store_xxx or
# mem_service_xxx. Do NOT paste an ISxxx / GAxxx SID here.
MEMORY_STORE_ID=

# Memora REST base URL (override only for non-prod environments).
MEMORY_API_URL=https://memory.twilio.com

# Comma-separated Trait Group names to include in the profile (e.g. Contact,Preferences).
# Leave empty to return all trait groups.
TWILIO_MEMORY_PROFILE_TRAIT_GROUPS=

# CORS allowlist. Use * locally; restrict to your Flex domain in production
# (e.g. https://flex.twilio.com) since this proxy returns customer PII.
ALLOWED_ORIGINS=*
