# Twilio API Key/Secret pair used as Basic auth (apiKey:apiToken) against the
# Memora API. Use a standard API Key (SKxxxx) + its secret — NOT the account
# auth token. Create one at: Console → Account → API keys & tokens.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Memora store / service SID — this is the value used in the API path
# (/v1/Stores/{MEMORY_STORE_ID}/...). It looks like mem_store_xxx or
# mem_service_xxx. Do NOT paste an ISxxx / GAxxx SID here.
MEMORY_STORE_ID=

# Memora REST base URL (override only for non-prod environments).
MEMORY_API_URL=https://memory.twilio.com

# Comma-separated Trait Group names to include in the profile (e.g. Contact,Preferences).
# Leave empty to return all trait groups.
TWILIO_MEMORY_PROFILE_TRAIT_GROUPS=

# CORS allowlist. Use * locally; restrict to your Flex domain in production
# (e.g. https://flex.twilio.com) since this proxy returns customer PII.
ALLOWED_ORIGINS=*

# --- Flex token validation (both functions require a valid agent token) ------
# Auto-injected by the Twilio Functions runtime when deployed; set locally so
# twilio-run can validate the agent's Flex token against your account.
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_account_auth_token

# --- Enterprise Knowledge search (search-knowledge function) ------------------
# Knowledge Base id to search (from GET memory.twilio.com/v1/ControlPlane/KnowledgeBases).
KNOWLEDGE_BASE_ID=
# Optional: comma-separated Knowledge source ids to scope search to specific sources.
KNOWLEDGE_IDS=
# Knowledge REST base URL (search host differs from memory's).
KNOWLEDGE_API_URL=https://knowledge.twilio.com

# --- Grounded summarize (summarize function) ---------------------------------
# OpenAI key for the "Summarize" action (grounded synthesis over search results).
OPENAI_API_KEY=
# Model (default gpt-4o-mini — fast + cheap for grounded summarization).
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible base URL (override for Azure/proxies).
OPENAI_API_URL=https://api.openai.com/v1

# --- Agent productivity capture (capture-turn function) ----------------------
# The agent-dedicated CO configuration (from infra/agent-productivity create:co).
AGENT_CONVERSATION_CONFIGURATION_ID=
# The agent-dedicated memory store (from create:store) — for agent profiles.
AGENT_MEMORY_STORE_ID=
# The custom identifier the agent profile is keyed by (registered by create:store).
AGENT_MEMORY_ID_TYPE=workerSid
# Sessions are CO-native: the agent is a CUSTOMER participant, so GROUP_BY_PROFILE
# enforces one open conversation per agent (a duplicate POST 409s with the open
# id). No Sync service, and no runtime idle var here — the session boundary is the
# CO config's CHAT `closed` timeout (SESSION_IDLE_MINUTES, set at provisioning).
# Hosts (override only for non-prod).
CONVERSATIONS_API_URL=https://conversations.twilio.com
MEMORY_API_URL=https://memory.twilio.com
