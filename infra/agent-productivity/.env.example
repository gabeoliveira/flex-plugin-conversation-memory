# API Key/Secret (Basic auth) for all Twilio control-plane calls.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- Filled in as you run the scripts (paste the printed ids) ----------------
# create-agent-memory-store.ts
AGENT_MEMORY_STORE_ID=
# create-agent-operator.ts
AGENT_OPERATOR_ID=
# create-agent-intelligence-config.ts  (needs AGENT_OPERATOR_ID; optional CIRL webhook)
AGENT_INTELLIGENCE_CONFIGURATION_ID=
CIRL_WEBHOOK_URL=
# create-agent-co-config.ts  (needs AGENT_MEMORY_STORE_ID + AGENT_INTELLIGENCE_CONFIGURATION_ID)
AGENT_CONVERSATION_CONFIGURATION_ID=

# Session inactivity window (MINUTES) — the CO CHAT "closed" timeout IS the
# session boundary: after this many idle minutes CO closes the conversation and
# CONVERSATION_END fires the CI operator once for the whole session. Sessions are
# CO-native (find-or-create by profile) — no Sync service is used.
SESSION_IDLE_MINUTES=5

# Override hosts only for non-prod.
MEMORY_API_URL=https://memory.twilio.com
CONVERSATIONS_API_URL=https://conversations.twilio.com
INTELLIGENCE_API_URL=https://intelligence.twilio.com
