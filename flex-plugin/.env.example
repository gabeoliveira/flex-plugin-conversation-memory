# Base URL of the Twilio Functions service hosting /get-memory.
# Only FLEX_APP_-prefixed vars are inlined into the plugin bundle at build time.
# NEVER put Memora credentials here — they live in the serverless service only.
#
# Local:    http://localhost:3001
# Deployed: https://conversation-memory-xxxx-dev.twil.io
FLEX_APP_FUNCTIONS_BASE_URL=http://localhost:3001

# --- Optional feature flags (build-time; default ON) -------------------------
# Set to false/0/off/no to disable. Inlined at build, so rebuild after changing.
#
# Hide the OpenAI-backed "Summarize" button — the panel becomes memory +
# knowledge + search only, with NO OpenAI dependency (customers who want just
# search + traits). The serverless OPENAI_API_KEY can be left unset too.
# FLEX_APP_ENABLE_SUMMARIZE=false
#
# Turn off the Phase 6 agent-productivity capture entirely (no /capture-turn call).
# FLEX_APP_ENABLE_CAPTURE=false
#
# Force a UI language (IETF tag, e.g. pt-BR). By default the panel follows Flex's
# own locale (Manager…localization.localeTag); set this only to override it.
# FLEX_APP_LOCALE=pt-BR

# --- Runtime config (no rebuild) via Flex ui_attributes (D3) -----------------
# Everything above has a runtime equivalent that OVERRIDES the build-time value,
# so customers can reconfigure without rebuilding. Set it in your Flex
# Configuration ui_attributes (Flex Configuration REST API) under the
# "conversation_memory" namespace:
#   {
#     "conversation_memory": {
#       "locale": "pt-BR",
#       "enableSummarize": false,
#       "enableCapture": true,
#       "traitGroups": {
#         "order":  ["Contact", "DasaClient"],   // display order (unlisted follow)
#         "hidden": ["Internal"],                // groups to hide
#         "labels": { "DasaClient": "Cliente Dasa" }  // display labels
#       }
#     }
#   }
